//! Generated tests for AADL thread: Single::filter
//! DO NOT EDIT — regenerate with `spar codegen`.

use super::filter::*;

#[test]
fn filter_compute_dispatches() {
    let mut comp = FilterDefault;
    let mut ports = FilterPorts::default();
    comp.compute(&mut ports);
}

#[test]
fn filter_timing_consistent() {
    // Deadline must not exceed period
    assert!(DEADLINE_PS <= PERIOD_PS, "deadline exceeds period");
    // WCET must not exceed deadline
    assert!(WCET_PS <= DEADLINE_PS, "WCET exceeds deadline");
    // WCET must not exceed period
    assert!(WCET_PS <= PERIOD_PS, "WCET exceeds period");
}

#[test]
fn filter_has_expected_ports() {
    // AADL model declares 2 features
    let ports = FilterPorts::default();
    let _ = std::mem::size_of_val(&ports);
}

