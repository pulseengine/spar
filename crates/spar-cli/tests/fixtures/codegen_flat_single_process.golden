//! Generated from AADL thread: Single::filter
//! DO NOT EDIT — regenerate with `spar codegen`.

/// Thread period: 10 ms
pub const PERIOD_PS: u64 = 10000000000;
/// Thread deadline: 10 ms
pub const DEADLINE_PS: u64 = 10000000000;
/// Worst-case execution time: 3 ms
pub const WCET_PS: u64 = 3000000000;

/// Port interface for the filter thread.
#[derive(Debug, Default)]
pub struct FilterPorts {
    /// in DataPort port
    pub raw: u32,
    /// out DataPort port
    pub clean: u32,
}

/// Dispatch trait for the filter thread (Periodic).
pub trait FilterComponent {
    /// Called on each dispatch (Periodic).
    fn compute(&mut self, ports: &mut FilterPorts);
}

/// Default implementation skeleton.
#[derive(Default)]
pub struct FilterDefault;

impl FilterComponent for FilterDefault {
    fn compute(&mut self, _ports: &mut FilterPorts) {
        // TODO: compute logic
    }
}

==> crates/sensor_app/src/lib.rs (1718 bytes) <==
//! Generated WIT bindings for AADL process: Single::sensor_app
//! DO NOT EDIT — regenerate with `spar codegen`.
//!
//! Data plane: each thread's `compute` reads its In ports from the imported
//! `{proc}-ports` functions, runs the component, and writes its Out ports back
//! (REQ-CODEGEN-WIT-DATAPLANE-001). Each thread's component instance is held in
//! a `thread_local!` and reused across dispatches so state persists;
//! inter-thread connections are carried by `thread_local!` buffers with
//! latest-value semantics (REQ-CODEGEN-WIT-STATE-001). Note: user state lives
//! in the `{thread}.rs` skeleton, which regen overwrites.

#![allow(unsafe_op_in_unsafe_fn, dead_code)]

mod types;
mod filter;

wit_bindgen::generate!({
    world: "sensor-app-world",
    path: "../../wit/sensor-app.wit",
});

// Persistent per-thread component state + inter-thread buffers. Reused
// across dispatches; single-threaded, non-reentrant wasip2 component so the
// RefCell borrows cannot alias. REQ-CODEGEN-WIT-STATE-001.
thread_local! { static FILTER_STATE: std::cell::RefCell<crate::filter::FilterDefault> = std::cell::RefCell::new(Default::default()); }

/// Component entry point, exported to the WIT world.
struct Component;

impl Guest for Component {
    fn filter_compute() {
        use crate::filter::FilterComponent;
        FILTER_STATE.with(|__st| {
            let mut component = __st.borrow_mut();
            let mut ports = crate::filter::FilterPorts::default();
            ports.raw = crate::single::sensor_app::sensor_app_ports::raw();
            component.compute(&mut ports);
            crate::single::sensor_app::sensor_app_ports::set_clean(ports.clean);
        });
    }
}

export!(Component);

