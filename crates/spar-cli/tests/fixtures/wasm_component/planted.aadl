-- Planted defect for the headless component oracle
-- (crates/spar-cli/tests/wasm_component_agreement.rs): connection c joins
-- two `in` ports across siblings, so its source has the wrong direction.
-- direction_rules must report it as an error on Top.impl.
package Planted
public
  process Node
    features
      p : in data port;
  end Node;

  process implementation Node.impl
  end Node.impl;

  system Top
  end Top;

  system implementation Top.impl
    subcomponents
      a : process Node.impl;
      b : process Node.impl;
    connections
      c : port a.p -> b.p;
  end Top.impl;
end Planted;
