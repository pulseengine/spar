-- TEST-CODEGEN-SUMMARY-HINT: a system with one process holding one thread.
-- `spar codegen --format wit` must emit a .wit file and no hint.
package Proc
public
  thread Worker
  end Worker;

  thread implementation Worker.impl
  end Worker.impl;

  process App
  end App;

  process implementation App.impl
    subcomponents
      w: thread Worker.impl;
  end App.impl;

  system Sys
  end Sys;

  system implementation Sys.impl
    subcomponents
      app: process App.impl;
  end Sys.impl;
end Proc;
